# Application
APP_NAME="KI Smart Attendance+"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY=ki-smart-attendance-dev-secret-key-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="KI_Smart_Attendance"

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,webp

# Firebase
FIREBASE_ENABLED=false

# Email
EMAIL_ENABLED=false

# Attendance Rules
DEFAULT_TARGET_ATTENDANCE=75.0
LEAVE_CUTOFF_TIME=09:00
LEAVE_NEXT_OPENING_TIME=09:00

# QR Settings
QR_EXPIRY_SECONDS=300

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
